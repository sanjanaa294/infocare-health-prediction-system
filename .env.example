# Environment Configuration
# Copy this file to .env and configure your values

# OpenRouter API Key
# Obtain an API key from OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key

# OpenRouter Model Selection (e.g., openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct, google/gemini-2.5-flash)
OPENROUTER_MODEL=your_selected_model

# Database URL (defaults to sqlite:///./health_records.db)
DATABASE_URL=sqlite:///./health_records.db

# Application Settings
APP_NAME="HealthCare AI Prediction & Patient Management"
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
